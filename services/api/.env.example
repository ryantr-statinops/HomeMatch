# Server-only configuration. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Add Google Drive credentials only when the media module is implemented.
GOOGLE_DRIVE_CLIENT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3001
# Configure this in Preview only when a stable preview hostname is unavailable.
ALLOWED_ORIGIN_REGEX=
