# Server-only configuration. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Drive writes use a Shared Drive folder. Keep the JSON server-only.
GOOGLE_DRIVE_FOLDER_ID=your-staging-folder-id
GOOGLE_SERVICE_ACCOUNT_JSON=

# Keep disabled until staging migrations, Auth/RBAC and backups are verified.
ADMIN_MUTATIONS_ENABLED=false

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3001
# Configure this in Preview only when a stable preview hostname is unavailable.
ALLOWED_ORIGIN_REGEX=
