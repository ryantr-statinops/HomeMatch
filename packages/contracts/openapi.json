            "format": "date-time",
            "title": "Close Time",
            "type": "string"
          },
          "high": {
            "title": "High",
            "type": "string"
          },
          "instrument_id": {
            "title": "Instrument Id",
            "type": "string"
          },
          "interval": {
            "enum": [
              "15m",
              "1h",
              "1d"
            ],
            "title": "Interval",
            "type": "string"
          },
          "is_closed": {
            "const": true,
            "title": "Is Closed",
            "type": "boolean"
          },
          "low": {
            "title": "Low",
            "type": "string"
          },
          "open": {
            "title": "Open",
            "type": "string"
          },
          "open_time": {
            "format": "date-time",
            "title": "Open Time",
            "type": "string"
          },
          "volume": {
            "title": "Volume",
            "type": "string"
          }
