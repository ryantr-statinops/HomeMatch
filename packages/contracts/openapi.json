        "type": "object"
      },
      "Meta": {
        "additionalProperties": false,
        "properties": {
          "is_synthetic": {
            "const": true,
            "default": true,
            "title": "Is Synthetic",
            "type": "boolean"
          }
        },
        "title": "Meta",
        "type": "object"
