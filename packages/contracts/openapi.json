        "properties": {
          "first_seen_at": {
            "format": "date-time",
            "title": "First Seen At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "instrument_ids": {
            "items": {
              "type": "string"
            },
            "title": "Instrument Ids",
            "type": "array"
          },
          "language": {
            "title": "Language",
            "type": "string"
          },
          "published_at": {
            "format": "date-time",
            "title": "Published At",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "id",
          "title",
          "instrument_ids",
          "published_at",
          "first_seen_at",
          "language",
          "url"
        ],
        "title": "Article",
        "type": "object"
      },
      "Candle": {
        "additionalProperties": false,
