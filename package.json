{
  "name": "research-terminal", "version": "0.1.0", "private": true,
  "workspaces": ["apps/web"],
  "engines": {"node": ">=22.12 <23"},
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "npm run dev --workspace=@research-terminal/web",
    "build": "npm run build --workspace=@research-terminal/web",
    "typecheck": "npm run typecheck --workspace=@research-terminal/web",
    "lint": "eslint apps/web/src",
    "security:env-boundaries": "node scripts/check-env-boundaries.mjs",
    "fixtures:check": "node scripts/check-fixtures.mjs",
    "test:tooling": "node --test scripts/check-env-boundaries.test.mjs"
  },
  "devDependencies": {"eslint": "9.39.4", "typescript-eslint": "8.71.2", "typescript": "6.0.3"}
}
